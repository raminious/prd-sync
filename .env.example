# Password for the web editor (HTTP Basic). The user name is your name: it becomes the author
# of each version. The app is locked when this is empty.
ADMIN_PASSWORD=

# Bearer token for /api. Each repo that fetches PRDs keeps the same value in its .env.
PRD_API_TOKEN=

# Slack incoming webhook for the "PRD changed" message. Empty = the message goes to the server log.
SLACK_WEBHOOK_URL=

# Public address of this app. Used in the Slack links and in the curl examples.
APP_URL=http://localhost:3210

# Optional. Default: data/prd.db
# DATABASE_PATH=
